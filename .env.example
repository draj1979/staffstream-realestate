# Copy this file to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection string used by Prisma (Cloud SQL / local Postgres instance)
DATABASE_URL="postgresql://user:password@localhost:5432/staffstream?schema=public"

# Separate empty database `prisma migrate dev` uses to diff schema changes.
# Only needed for local dev. Don't point this (or DATABASE_URL) at a
# database literally named `template1` — Postgres uses it as the default
# template for new databases and that can corrupt this workflow.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/staffstream_shadow?schema=public"

# Google Gemini API key used to power the AI sales agent (currently
# google/gemini-3.1-flash-lite — see lib/agent/workspace.ts)
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Anthropic Claude API key — no longer the active model (see above), kept
# for reference in case of a rollback. Safe to leave unset.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# local path OpenClaw will use for its workspace/session files
OPENCLAW_WORKSPACE_PATH="./.openclaw-workspace"

# Name of the Google Cloud Storage bucket used to store uploaded PDF brochures
GCS_BUCKET_NAME="staffstream-brochures"

# Google Cloud project ID that owns the storage bucket
GCS_PROJECT_ID="your-gcp-project-id"

# Permanent access token for the WhatsApp Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Phone number ID of the WhatsApp Business number leads message into
WHATSAPP_PHONE_NUMBER_ID="000000000000000"

# App secret used to verify WhatsApp webhook signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET="your-whatsapp-app-secret"

# Arbitrary string used to verify the WhatsApp webhook subscription handshake
WHATSAPP_VERIFY_TOKEN="choose-a-random-verify-token"

# Random secret (32+ chars) used by iron-session to sign/encrypt the login session cookie
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Email address of the single logged-in builder admin
ADMIN_EMAIL="admin@example.com"

# Plaintext password for the builder admin — used ONLY by `npm run seed:admin`
# to create the User row (it hashes this with bcrypt and never stores or
# logs the plaintext). Not read anywhere else; rotate/remove after seeding.
ADMIN_PASSWORD="replace-with-a-strong-password"

# Shared secret Cloud Scheduler must send as X-Cron-Secret to call
# POST /api/cron/followups — not a session cookie, this endpoint has no browser user
CRON_SECRET="replace-with-a-long-random-string"

# Hours of no contact before a lead becomes eligible for an automated
# WhatsApp follow-up (POST /api/cron/followups). Optional — defaults to 24.
FOLLOWUP_THRESHOLD_HOURS="24"
